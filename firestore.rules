rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || (data[key] is number);
    }

    function isOptionalCurrency(data, key) {
      return !(key in data) || (data[key] in ['TRY', 'USD', 'EUR', 'GBP']);
    }

    // Validation Blueprints
    function isValidBusinessProfile(data) {
      return data.keys().hasAll(['ownerId', 'title', 'taxId', 'defaultGibMode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'title', 'taxId', 'taxOffice', 'address',
          'city', 'district', 'phone', 'email', 'iban', 'defaultInvoiceNote',
          'defaultGibMode', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.taxId is string && data.taxId.size() <= 11
        && isOptionalString(data, 'taxOffice', 100)
        && isOptionalString(data, 'address', 300)
        && isOptionalString(data, 'city', 60)
        && isOptionalString(data, 'district', 60)
        && isOptionalString(data, 'phone', 24)
        && isOptionalString(data, 'email', 120)
        && isOptionalString(data, 'iban', 40)
        && isOptionalString(data, 'defaultInvoiceNote', 300)
        && data.defaultGibMode in ['live', 'test']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['ownerId', 'name', 'accountType', 'balance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'name', 'taxId', 'taxOffice', 'phone',
          'email', 'address', 'city', 'district', 'accountType',
          'balance', 'currency', 'usdBalance', 'eurBalance', 'gbpBalance',
          'nextDueDate', 'paymentTermDays', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && isOptionalString(data, 'taxId', 11)
        && isOptionalString(data, 'taxOffice', 100)
        && isOptionalString(data, 'phone', 24)
        && isOptionalString(data, 'email', 120)
        && isOptionalString(data, 'address', 300)
        && isOptionalString(data, 'city', 60)
        && isOptionalString(data, 'district', 60)
        && data.accountType in ['customer', 'supplier', 'both']
        && data.balance is number
        && isOptionalCurrency(data, 'currency')
        && isOptionalNumber(data, 'usdBalance')
        && isOptionalNumber(data, 'eurBalance')
        && isOptionalNumber(data, 'gbpBalance')
        && isOptionalString(data, 'nextDueDate', 20)
        && (!('paymentTermDays' in data) || (data.paymentTermDays is number && data.paymentTermDays >= 0 && data.paymentTermDays <= 3650))
        && isOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['ownerId', 'type', 'category', 'amount', 'vatRate', 'date', 'paymentMethod', 'affectsBalance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'type', 'category', 'amount', 'currency', 'originalAmount',
          'exchangeRate', 'entryKind', 'vatRate', 'description',
          'date', 'paymentMethod', 'accountId', 'accountName', 'invoiceId',
          'affectsBalance', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.type in ['income', 'expense']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.amount is number && data.amount > 0
        && isOptionalCurrency(data, 'currency')
        && (!('originalAmount' in data) || (data.originalAmount is number && data.originalAmount > 0))
        && (!('exchangeRate' in data) || (data.exchangeRate is number && data.exchangeRate > 0))
        && (!('entryKind' in data) || (data.entryKind in ['ledger', 'sale', 'collection', 'payment', 'check_note']))
        && data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 100
        && isOptionalString(data, 'description', 300)
        && data.date is string && data.date.size() >= 8 && data.date.size() <= 20
        && data.paymentMethod in ['cash', 'bank', 'pos', 'transfer']
        && isOptionalString(data, 'accountId', 128)
        && isOptionalString(data, 'accountName', 160)
        && isOptionalString(data, 'invoiceId', 128)
        && data.affectsBalance is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedItem(data) {
      return data.keys().hasAll(['ownerId', 'name', 'unit', 'unitPrice', 'vatRate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'unit', 'unitPrice', 'vatRate', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30
        && data.unitPrice is number && data.unitPrice >= 0
        && data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll([
          'ownerId', 'ettn', 'invoiceNo', 'invoiceDate', 'invoiceTime',
          'invoiceType', 'gibMode', 'status', 'recipientName', 'recipientTaxId',
          'items', 'subtotal', 'vatTotal', 'grandTotal', 'reflectedToLedger',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'ettn', 'invoiceNo', 'invoiceDate', 'invoiceTime',
          'invoiceType', 'gibMode', 'status', 'currency', 'exchangeRate',
          'sellerTitle', 'sellerTaxId', 'sellerTaxOffice', 'sellerAddress',
          'recipientAccountId', 'recipientName', 'recipientTaxId',
          'recipientTaxOffice', 'recipientAddress', 'recipientCity',
          'recipientDistrict', 'items', 'subtotal', 'vatTotal', 'grandTotal',
          'note', 'smsApprovedAt', 'reflectedToLedger', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.ettn is string && data.ettn.size() >= 1 && data.ettn.size() <= 64
        && data.invoiceNo is string && data.invoiceNo.size() >= 1 && data.invoiceNo.size() <= 40
        && data.invoiceDate is string && data.invoiceDate.size() >= 8 && data.invoiceDate.size() <= 20
        && data.invoiceTime is string && data.invoiceTime.size() >= 4 && data.invoiceTime.size() <= 12
        && data.invoiceType in ['SATIS', 'IADE']
        && data.gibMode in ['live', 'test']
        && data.status in ['draft', 'approved', 'cancelled']
        && isOptionalCurrency(data, 'currency')
        && (!('exchangeRate' in data) || (data.exchangeRate is number && data.exchangeRate > 0))
        && isOptionalString(data, 'sellerTitle', 160)
        && isOptionalString(data, 'sellerTaxId', 11)
        && isOptionalString(data, 'sellerTaxOffice', 100)
        && isOptionalString(data, 'sellerAddress', 300)
        && isOptionalString(data, 'recipientAccountId', 128)
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 160
        && data.recipientTaxId is string && data.recipientTaxId.size() >= 10 && data.recipientTaxId.size() <= 11
        && isOptionalString(data, 'recipientTaxOffice', 100)
        && isOptionalString(data, 'recipientAddress', 300)
        && isOptionalString(data, 'recipientCity', 60)
        && isOptionalString(data, 'recipientDistrict', 60)
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.items[0] is map
        && data.items[0].name is string && data.items[0].name.size() >= 1 && data.items[0].name.size() <= 180
        && data.subtotal is number && data.subtotal >= 0
        && data.vatTotal is number && data.vatTotal >= 0
        && data.grandTotal is number && data.grandTotal >= 0
        && isOptionalString(data, 'note', 1000)
        && isOptionalString(data, 'smsApprovedAt', 40)
        && data.reflectedToLedger is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGibCredential(data) {
      return data.keys().hasAll(['ownerId', 'userCode', 'encryptedSecret', 'mode', 'autoConnect', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'userCode', 'encryptedSecret', 'mode', 'autoConnect', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.userCode is string && data.userCode.size() >= 1 && data.userCode.size() <= 40
        && data.encryptedSecret is string && data.encryptedSecret.size() >= 1 && data.encryptedSecret.size() <= 512
        && data.mode in ['live', 'test']
        && data.autoConnect is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpenseCategory(data) {
      return data.keys().hasAll(['ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCheckNote(data) {
      return data.keys().hasAll([
          'ownerId', 'kind', 'direction', 'bankOrIssuer', 'amount',
          'currency', 'exchangeRate', 'amountTry', 'dueDate', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'kind', 'direction', 'documentNo', 'bankOrIssuer',
          'accountId', 'accountName', 'amount', 'currency', 'exchangeRate',
          'amountTry', 'issueDate', 'dueDate', 'status', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
        && data.kind in ['cek', 'senet']
        && data.direction in ['receivable', 'payable']
        && isOptionalString(data, 'documentNo', 64)
        && data.bankOrIssuer is string && data.bankOrIssuer.size() >= 1 && data.bankOrIssuer.size() <= 160
        && isOptionalString(data, 'accountId', 128)
        && isOptionalString(data, 'accountName', 160)
        && data.amount is number && data.amount > 0
        && data.currency in ['TRY', 'USD', 'EUR', 'GBP']
        && data.exchangeRate is number && data.exchangeRate > 0
        && data.amountTry is number && data.amountTry > 0
        && isOptionalString(data, 'issueDate', 20)
        && data.dueDate is string && data.dueDate.size() >= 8 && data.dueDate.size() <= 20
        && data.status in ['pending', 'collected', 'paid', 'bounced']
        && isOptionalString(data, 'notes', 300)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. İşletme Profili (PII İzole — yalnızca kendi UID belgesine erişim)
    match /businessProfiles/{profileId} {
      allow get: if isSignedIn() && isValidId(profileId) && profileId == request.auth.uid && existing().ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(profileId)
        && profileId == request.auth.uid
        && isValidBusinessProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(profileId)
        && profileId == request.auth.uid
        && isValidBusinessProfile(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'taxId', 'taxOffice', 'address', 'city',
          'district', 'phone', 'email', 'iban', 'defaultInvoiceNote',
          'defaultGibMode', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 2. Cari Hesaplar (Müşteri / Tedarikçi)
    match /accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(accountId)
        && isValidAccount(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(accountId)
        && isValidAccount(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Cari kart bilgilerini güncelle
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'taxId', 'taxOffice', 'phone', 'email', 'address',
            'city', 'district', 'accountType', 'currency',
            'nextDueDate', 'paymentTermDays', 'notes', 'updatedAt'
          ]) ||
          // Action: Tahsilat / Ödeme / Dövizli Satış / Fatura sonrası bakiye güncelle
          incoming().diff(existing()).affectedKeys().hasOnly([
            'balance', 'usdBalance', 'eurBalance', 'gbpBalance', 'updatedAt'
          ])
        );
      allow delete: if isSignedIn() && isValidId(accountId) && existing().ownerId == request.auth.uid;
    }

    // 3. Gelir-Gider Hareketleri
    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(txId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(txId)
        && isValidTransaction(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'type', 'category', 'amount', 'currency', 'originalAmount',
          'exchangeRate', 'entryKind', 'vatRate', 'description',
          'date', 'paymentMethod', 'accountId', 'accountName', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(txId) && existing().ownerId == request.auth.uid;
    }

    // 4. İsteğe Bağlı Kaydedilen Kalemler (Stok takibi yok)
    match /savedItems/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(itemId)
        && isValidSavedItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(itemId)
        && isValidSavedItem(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'unit', 'unitPrice', 'vatRate', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
    }

    // 5. e-Arşiv Fatura Arşivi
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && isValidId(invoiceId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(invoiceId)
        && isValidInvoice(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(invoiceId)
        && isValidInvoice(incoming())
        && existing().ownerId == request.auth.uid
        && existing().status != 'cancelled'
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Taslak faturayı SMS onayı ile onaylı duruma geçir
          (
            existing().status == 'draft' &&
            incoming().status in ['draft', 'approved'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'invoiceNo', 'status', 'smsApprovedAt', 'reflectedToLedger', 'updatedAt'
            ])
          ) ||
          // Action 2: Onaylı faturayı deftere işlenmiş olarak işaretle
          (
            existing().status == 'approved' &&
            incoming().status == 'approved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reflectedToLedger', 'updatedAt'])
          ) ||
          // Action 3: Faturayı iptal et (Terminal durum)
          (
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn()
        && isValidId(invoiceId)
        && existing().ownerId == request.auth.uid
        && (existing().gibMode == 'test' || existing().status == 'draft');
    }

    // 6. Şifrelenmiş GİB Kimlik Bilgileri (PII/Secret İzole — yalnızca kendi UID belgesi)
    match /gibCredentials/{credId} {
      allow get: if isSignedIn() && isValidId(credId) && credId == request.auth.uid && existing().ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(credId)
        && credId == request.auth.uid
        && isValidGibCredential(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(credId)
        && credId == request.auth.uid
        && isValidGibCredential(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'userCode', 'encryptedSecret', 'mode', 'autoConnect', 'updatedAt'
        ]);
      allow delete: if isSignedIn()
        && isValidId(credId)
        && credId == request.auth.uid
        && existing().ownerId == request.auth.uid;
    }

    // 7. Özel Gider Kalemleri (Ayarlar Sayfası)
    match /expenseCategories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(categoryId)
        && isValidExpenseCategory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(categoryId)
        && isValidExpenseCategory(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(categoryId) && existing().ownerId == request.auth.uid;
    }

    // 8. Çek ve Senet Portföyü
    match /checksNotes/{itemId} {
      allow get: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(itemId)
        && isValidCheckNote(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(itemId)
        && isValidCheckNote(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Çek/senet bilgilerini düzenle
          incoming().diff(existing()).affectedKeys().hasOnly([
            'kind', 'direction', 'documentNo', 'bankOrIssuer',
            'accountId', 'accountName', 'amount', 'currency', 'exchangeRate',
            'amountTry', 'issueDate', 'dueDate', 'notes', 'updatedAt'
          ]) ||
          // Action 2: Durum güncelle (Tahsil edildi / Ödendi / Karşılıksız)
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
    }
  }
}
